			<string>驾驶伴侣手机端协议服务器（v1.0：握手阶段）</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>com.elinkbridge.ios</string>
