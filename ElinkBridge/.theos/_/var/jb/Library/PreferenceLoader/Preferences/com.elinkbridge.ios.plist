		<string>ElinkBridge</string>
		<key>isController</key>
		<true/>
		<key>detail</key>
		<string>PSListController</string>
		<key>bundlePath</key>
		<string>/Library/PreferenceLoader/Preferences</string>
	</dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
